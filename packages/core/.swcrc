{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [".test.ts", ".types.ts", ".stories.ts"],
  "jsc": {
      "parser": {
          "syntax": "typescript",
          "decorators": true
      },
      "target": "esnext",
      "transform": {
          "useDefineForClassFields": false
      },
      "experimental": {
            "plugins": [[
                "@swc/plugin-transform-imports", {
                    "^(.*?)(\\.ts)$": {
                        "skipDefaultConversion": true,
                        "transform": "{{matches.[1]}}.js"
                    },
                    "^(.*?)(\\.types\\.ts)$": {
                        "skipDefaultConversion": true,
                        "transform": "{{matches.[1]}}.types.d.ts"
                    }
                }
            ]]
        }
  }
}