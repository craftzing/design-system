{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [".test.ts", ".types.ts", ".stories.ts"],
  "jsc": {
      "parser": {
          "syntax": "typescript",
          "decorators": true
      },
      "target": "esnext",
      "transform": {
          "useDefineForClassFields": false
      }
  }
}