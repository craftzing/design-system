{
  "name": "design-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [],
  "targets": {
    "build-rollup": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/design-system",
        "entryFile": "packages/design-system/src/index.ts",
        "tsConfig": "packages/design-system/tsconfig.lib.json",
        "generateExportsField": true,
        "additionalEntryPoints": [
          "packages/design-system/src/lib/button/index.ts"
        ]
      }
    },
    "build": {
      "executor": "@nx/js:swc",
      "options": {
        "outputPath": "dist/packages/design-system",
        "main": "packages/design-system/src/index.ts",
        "tsConfig": "packages/design-system/tsconfig.lib.json",
        "assets": ["packages/design-system/*.md"],
        "generateExportsField": true,
        "additionalEntryPoints": [
          "packages/design-system/src/lib/button/index.ts"
        ],
        "swcrc": "packages/design-system/.swcrc"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
